{
	"schemaVersion": 1,
	"id": "autologin",
	"version": "${version}",
	"name": "AutoLogin",
	"description": "Client-side Fabric mod that automatically logs you in on servers that ask for it.",
	"authors": [
		"Mohenjo"
	],
	"contact": {
		"homepage": "https://renderdragon.org",
		"sources": "https://github.com/MohenjoMC/autologin"
	},
	"license": "CC0-1.0",
	"icon": "assets/autologin/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.monhenjo.autologin.client.AutoLoginClient"
		]
	},
	"mixins": [
		{
			"config": "autologin.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "${minecraft_dependency}",
		"java": ">=25",
		"fabric-api": "*"
	}
}
