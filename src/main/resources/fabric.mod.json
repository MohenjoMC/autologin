{
	"schemaVersion": 1,
	"id": "autologin",
	"version": "${version}",
	"name": "AutoLogin",
	"description": "Password manager for Minecraft servers that ask for a password. Detects login prompts, keeps passwords encrypted on disk, and sends the one you pick.",
	"authors": [
		"Mohenjo"
	],
	"contact": {
		"homepage": "https://renderdragon.org",
		"sources": "https://github.com/MohenjoMC/autologin"
	},
	"license": "CC0-1.0",
	"icon": "assets/autologin/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.monhenjo.autologin.client.AutoLoginClient"
		],
		"modmenu": [
			"com.monhenjo.autologin.client.integration.ModMenuIntegration"
		],
		"main": [
			"com.monhenjo.autologin.AutoLogin"
		]
	},
	"mixins": [
		{
			"config": "autologin.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "${minecraft_dependency}",
		"java": ">=25",
		"fabric-api": "*",
		"cloth-config": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
